/* pages/details/details.wxss */
.mypicture{
  width: 200rpx;
  height: 200rpx;
  border-radius: 90%;
}

.img-box{
  display: flex;
  justify-content: center;
}

.info-box {
  background-color: #f9f9f9;
  border-radius: 10px;
  padding: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  margin-bottom: 16px;
}

.info-title {
  font-size: 20px;
  font-weight: bold;
  color: #333;
  margin-bottom: 15px;
  text-align: center;
}

.info-item {
  margin-bottom: 15px;
}

.info-label {
  font-size: 16px;
  color: #555;
  font-weight: 500;
}

.info-content {
  font-size: 16px;
  color: #333;
}

.copy-content{
  word-break: break-word;
  white-space: normal;
  overflow-wrap: break-word;
  color: #37587c;
  text-decoration: underline;
  cursor: pointer;
}

.quota-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin: 10rpx 8rpx 6rpx;
}

.quota-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between; /* 两端对齐，中间留空 */
  padding: 10rpx 16rpx 16rpx;
  box-sizing: border-box;
  width: 100%;
}

.quota-item {
  /* 严格设定为 48% 宽度（不依赖 calc 或者 gap），确保任何设备都绝对能排下两个并中间留出 4% 的空白 */
  width: 48%;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.quota-btn {
  width: 100%;
  /* 强制按钮不能被内部文字无底线撑大 */
  max-width: 100%;
  overflow: hidden;
  min-height: 106rpx;
  /* 加入 flex 居中文字对齐，并切换为竖向排列 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  border: 2rpx solid rgba(65, 175, 179, 0.74);
  color: #333;
  /* 减少左右 padding 以确保小屏幕也有空间 */
  padding: 12rpx 4rpx;
  white-space: normal;
  word-break: break-all;
  margin: 0 !important;
  box-sizing: border-box;
}

.btn-text-name {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  text-align: center;
  /* 如果文字实在太多，让它变小或者允许两行字不会把容器撑破 */
  width: 100%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.btn-text-code {
  font-size: 22rpx;
  color: #555;
  line-height: 1.2;
  margin-top: 6rpx;
  width: 100%;
  text-align: center;
}

button:disabled {
  background-color: #d3d3d3;
  color: #a9a9a9;
}

/* 折叠面板样式 */
.collapse-group {
  margin: 10rpx 16rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.collapse-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #f0f7f7;
  cursor: pointer;
  border-bottom: 2rpx solid #e1eeee;
}

.collapse-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2b6c70;
}

.collapse-icon {
  font-size: 24rpx;
  color: #2b6c70;
  transition: transform 0.3s ease;
}

.collapse-icon.expanded {
  transform: rotate(180deg);
}

.collapse-content {
  padding: 20rpx 10rpx;
}
