<!-- 头像部分 -->
<view class="img-box">
<image src="{{teacher.picture}}" mode="" class="mypicture"/>
</view>
<!-- 个人信息部分 -->
<view class="info-box">
  <view class="info-title">个人信息</view>

  <view class="info-item">
    <text class="info-label">姓名：</text>
    <text class="info-content">{{teacher.name}}</text>
  </view>

  <view class="info-item">
    <text class="info-label">职称：</text>
    <text class="info-content">{{teacher.Jobposition}}</text>
  </view>

  <view class="info-item">
    <text class="info-label" >邮箱：</text>
    <text class="copy-content" bindtap="copyText" data-text="{{teacher.email}}">{{teacher.email}}</text>
  </view>

  <view class="info-item">
    <text class="info-label">研究方向：</text>
    <text class="info-content">{{teacher.ezresearch}}</text>
  </view>

  <view class="info-item">
    <text class="info-label">办公室：</text>
    <text class="info-content">{{teacher.office}}</text>
  </view>

  <view class="info-item">
    <text class="info-label">招生说明：</text>
    <text class="copy-content" bindtap="copyText" data-text="{{teacher.description}}">{{teacher.description}}</text>
  </view>
</view>

<view class="quota-title">可选专业（按方向分组下拉选择）</view>

<block wx:for="{{groupedQuota}}" wx:key="trackName">
  <view class="collapse-group" wx:if="{{item.items.length > 0}}">
    <!-- 折叠标题 -->
    <view class="collapse-header" bindtap="toggleCollapse" data-track="{{item.trackName}}">
      <text class="collapse-title">{{item.trackName}}（{{item.items.length}}）</text>
      <text class="collapse-icon {{item.expanded ? 'expanded' : ''}}">▼</text>
    </view>

    <!-- 下拉内容 -->
    <view class="collapse-content" wx:if="{{item.expanded}}">
      <view class="quota-grid">
        <view class="quota-item" wx:for="{{item.items}}" wx:key="key" wx:for-item="btn">
          <button
            class="quota-btn"
            style="background-color: {{btn.color}};"
            data-code="{{btn.code}}"
            data-name="{{btn.name}}"
            data-base-name="{{btn.baseName}}"
            data-track="{{btn.track}}"
            data-disabled="{{btn.disabled}}"
            bindtap="selectTeacherByCategory"
            disabled="{{btn.disabled}}"
          >
            <view class="btn-text-name">{{btn.name}}</view>
            <view class="btn-text-code">{{btn.code}}</view>
          </button>
        </view>
      </view>
    </view>
  </view>
</block>
